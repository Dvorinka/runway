# Runway instance configuration
APP_HOSTNAME=
DEPLOY_DOMAIN=
DATABASE_URL=postgres://runway:runway@localhost:5432/runway
SECRET_KEY=
ENCRYPTION_KEY=
# Compose-only (production.yml): postgres password + published ports.
# POSTGRES_PASSWORD=
# HTTP_PORT=80
# HTTPS_PORT=443
# TLS: "true" when a tunnel/proxy terminates TLS upstream; "false" for
# direct-IP + Let's Encrypt (set ACME_EMAIL, publish 443).
# DISABLE_TLS=false
# ACME_EMAIL=
# DOCKER_HOST=tcp://docker-proxy:2375
# DATA_DIR=./data
# HOST_DATA_DIR=
# RUNWAY_LISTEN=0.0.0.0:8000
# RUNWAY_ENV=development
# SERVER_IP=
# DEPLOYMENT_TIMEOUT_SECONDS=300
# MONITOR_INTERVAL_SECONDS=2
# Instance Cloudflare Tunnel (CGNAT path) — set both:
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# GitHub App (repos + webhooks). Optional — the dashboard can register a
# private app via Settings → GitHub App instead (credentials are stored
# encrypted in Postgres). Set these only to wire an existing app.
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_API_URL=https://api.github.com   # GHE: https://ghe.example.com/api/v3
# OIDC / SSO (optional alternative sign-in)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
# OIDC_DISPLAY_NAME=SSO
